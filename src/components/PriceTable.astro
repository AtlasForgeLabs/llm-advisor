---
import DataBadge from '@/components/DataBadge.astro';
import SmartLink from '@/components/SmartLink.astro';
import type { ApiPrice, SubscriptionPrice } from '@/lib/schema';

interface Props {
  mode: 'subscription' | 'api';
  prices: SubscriptionPrice[] | ApiPrice[];
}

const { mode, prices } = Astro.props;

function formatAmount(value: number | null | undefined, currency: string) {
  if (value === null || value === undefined) return null;
  return `${currency} ${value}`;
}

function verificationTone(status: string) {
  if (status === 'verified') return 'green';
  if (status === 'verified_with_warnings') return 'orange';
  return 'orange';
}

function displayStatus(price: SubscriptionPrice | ApiPrice) {
  if (price.metadata_only) return 'Plan metadata only';
  if (price.verification_status === 'verified_with_warnings') return 'Verified with warnings';
  if (price.verification_status === 'verified') return 'Source-backed';
  if (price.verification_status === 'needs_review') return 'Needs review';
  return 'Pending source-backed pricing';
}
---

{prices.length === 0 ? (
  <p>Pending source-backed pricing for this record.</p>
) : (
  <table class="data-table price-table">
    <thead>
      {mode === 'subscription' ? (
        <tr>
          <th>Plan price</th>
          <th>Region</th>
          <th>Amount</th>
          <th>Billing</th>
          <th>Source</th>
          <th>Checked</th>
          <th>Status</th>
        </tr>
      ) : (
        <tr>
          <th>Model / service</th>
          <th>Region</th>
          <th>Unit</th>
          <th>Input</th>
          <th>Output</th>
          <th>Other</th>
          <th>Source</th>
          <th>Checked</th>
          <th>Status</th>
        </tr>
      )}
    </thead>
    <tbody>
      {prices.map((price) => {
        const sub = mode === 'subscription' ? (price as SubscriptionPrice) : null;
        const api = mode === 'api' ? (price as ApiPrice) : null;
        const amountLabel = sub?.metadata_only
          ? sub.enterprise_contact_required
            ? 'Custom / contact sales'
            : sub.price_raw_text ?? 'Usage-based / metadata only'
          : sub?.amount === null || sub?.amount === undefined
            ? sub?.enterprise_contact_required
              ? 'Custom / contact sales'
              : sub?.price_raw_text ?? 'Pending source-backed pricing'
            : formatAmount(sub.amount, sub.currency);
        const otherCharges = api
          ? [
              api.request_price != null ? `Request: ${formatAmount(api.request_price, api.currency)}` : null,
              api.audio_price != null ? `Audio: ${formatAmount(api.audio_price, api.currency)}` : null,
              api.image_price != null ? `Image: ${formatAmount(api.image_price, api.currency)}` : null,
              api.input_price == null && api.output_price == null && api.price_raw_text
                ? api.price_raw_text
                : null
            ]
              .filter(Boolean)
              .join(' · ') || '—'
          : null;

        return (
          <tr>
            <td>
              <strong>{price.name}</strong>
              {price.import_warnings?.length ? (
                <div class="badge-row">
                  {price.import_warnings.map((warning) => (
                    <DataBadge label={warning} tone="orange" />
                  ))}
                </div>
              ) : null}
              {price.usd_reference_note ? <p class="price-note">{price.usd_reference_note}</p> : null}
            </td>
            <td>{price.pricing_region ?? '—'}</td>
            {mode === 'subscription' ? (
              <>
                <td>{amountLabel}</td>
                <td>{sub?.billing_unit ?? '—'}</td>
              </>
            ) : (
              <>
                <td>{api?.billing_unit ?? '—'}</td>
                <td>
                  {api?.input_price != null ? formatAmount(api.input_price, api.currency) : '—'}
                </td>
                <td>
                  {api?.output_price != null ? formatAmount(api.output_price, api.currency) : '—'}
                </td>
                <td>{otherCharges}</td>
              </>
            )}
            <td>
              {price.source_url ? (
                <SmartLink href={price.source_url}>Official source</SmartLink>
              ) : (
                '—'
              )}
            </td>
            <td>
              {price.source_accessed_at ? (
                <time datetime={price.source_accessed_at}>
                  {price.source_accessed_at.slice(0, 10)}
                </time>
              ) : (
                '—'
              )}
            </td>
            <td>
              <DataBadge label={displayStatus(price)} tone={verificationTone(price.verification_status)} />
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
)}
