---
import { externalLinkRel, isExternalHref } from '@/lib/links';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const external = isExternalHref(href);
---

<a
  href={href}
  class={className}
  target={external ? '_blank' : undefined}
  rel={external ? externalLinkRel : undefined}
>
  <slot />
</a>
