---
import SiteLayout from '@/layouts/SiteLayout.astro';
import InfoPage from '@/components/InfoPage.astro';
---

<SiteLayout title="Calculators" description="Static foundation page for future client-side AI cost calculators." canonicalPath="/calculators">
  <InfoPage title="Calculators" description="Future calculators will estimate AI subscription, API, and team costs entirely in the browser.">
    <p>No calculator logic is implemented in this initialization. When calculators are added, they must run client-side only and must not depend on server APIs or private backend storage.</p>
  </InfoPage>
</SiteLayout>
