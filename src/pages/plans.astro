---
import SiteLayout from '@/layouts/SiteLayout.astro';
import InfoPage from '@/components/InfoPage.astro';
---

<SiteLayout title="AI Plans" description="Static foundation page for future AI subscription plan comparisons." canonicalPath="/plans">
  <InfoPage title="AI Plans" description="This section will compare AI subscription plans using official sources, clear update dates, and transparent assumptions.">
