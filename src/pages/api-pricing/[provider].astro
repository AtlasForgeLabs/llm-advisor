---
import SiteLayout from '@/layouts/SiteLayout.astro';
import DataBadge from '@/components/DataBadge.astro';
import RecordSummary from '@/components/RecordSummary.astro';
import ApiPricingUnitGuide from '@/components/ApiPricingUnitGuide.astro';
import PriceTable from '@/components/PriceTable.astro';
import SourceList from '@/components/SourceList.astro';
import { getApiPricesByProvider, getProviders, getSourcesByIds, getVendors } from '@/lib/data';
export function getStaticPaths() { return getProviders().map((provider) => ({ params: { provider: provider.slug }, props: { provider } })); }
const { provider } = Astro.props;
const vendor = getVendors().find((item) => item.id === provider.vendor_id);
const prices = getApiPricesByProvider(provider.id);
const sources = getSourcesByIds(provider.source_ids);
---
<SiteLayout title={`${provider.name} API Pricing`} description={provider.description ?? `${provider.name} API pricing profile.`} canonicalPath={`/api-pricing/${provider.slug}`}>
  <section class="page-hero"><div class="container"><h1>{provider.name} API Pricing</h1><p>{provider.description}</p><div class="badge-row"><DataBadge label={provider.provider_type} tone="blue" /><DataBadge label={provider.verification_status} tone="orange" /></div></div></section>
  <section class="content-section"><div class="container data-shell"><div class="prose">
    <h2>Price records</h2>
    {provider.slug === 'openai-api' || provider.slug === 'anthropic-api' ? (
      <ApiPricingUnitGuide providerName={provider.name} />
    ) : null}
    <PriceTable mode="api" prices={prices} />
    <p>
      Each row lists billing units in plain text (for example per 1M tokens, per 1K searches, per
      request, per audio minute, or per session-hour). USD reference values for China pricing are
      reference-only when present.
    </p>
    <SourceList sources={sources} />
  </div><RecordSummary record={provider} extra={[{ label: 'Vendor', value: vendor?.name }, { label: 'Price records', value: prices.length }]} /></div></section>
</SiteLayout>
