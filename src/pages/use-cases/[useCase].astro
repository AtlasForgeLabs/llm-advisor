---
import SiteLayout from '@/layouts/SiteLayout.astro';
import DataBadge from '@/components/DataBadge.astro';
import RecordSummary from '@/components/RecordSummary.astro';
import SourceList from '@/components/SourceList.astro';
import { getProducts, getSourcesByIds, getUseCases } from '@/lib/data';
export function getStaticPaths() { return getUseCases().map((useCase) => ({ params: { useCase: useCase.slug }, props: { useCase } })); }
const { useCase } = Astro.props;
const products = getProducts().filter((product) => useCase.relevant_product_ids?.includes(product.id));
const sources = getSourcesByIds(useCase.source_ids);
---
<SiteLayout title={useCase.name} description={useCase.description ?? `${useCase.name} AI cost use case.`} canonicalPath={`/use-cases/${useCase.slug}`}>
  <section class="page-hero"><div class="container"><h1>{useCase.name}</h1><p>{useCase.description}</p><div class="badge-row"><DataBadge label={useCase.workload_type} tone="blue" /><DataBadge label={useCase.verification_status} tone="orange" /></div></div></section>
  <section class="content-section"><div class="container data-shell"><div class="prose">
    <h2>Audience</h2><div class="badge-row">{useCase.audience.map((audience) => <DataBadge label={audience} tone="muted" />)}</div>
    <h2>Decision factors</h2><ul>{useCase.decision_factors.map((factor) => <li>{factor}</li>)}</ul>
    <h2>Relevant products</h2><div class="directory-grid">{products.map((product) => <a class="card" href={`/products/${product.slug}`}><h3>{product.name}</h3><p>{product.description}</p></a>)}</div>
    <SourceList sources={sources} />
  </div><RecordSummary record={useCase} extra={[{ label: 'Products', value: products.length }]} /></div></section>
</SiteLayout>
