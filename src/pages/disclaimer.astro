---
import SiteLayout from '@/layouts/SiteLayout.astro';
import InfoPage from '@/components/InfoPage.astro';
import { site } from '@/data/site';
---

<SiteLayout title="Disclaimer" description="Important limitations for LLM Advisor pricing and AI product information." canonicalPath="/disclaimer">
  <InfoPage title="Disclaimer" description="AI pricing changes often. LLM Advisor is informational and should not be treated as a final procurement authority.">
    <p>Prices, limits, availability, and terms for AI products can change without notice. LLM Advisor may not reflect the latest vendor changes at the exact moment you read a page.</p>
    <p>Always confirm current pricing, taxes, regional availability, usage limits, enterprise terms, and contract requirements directly with the relevant provider before making a purchase or migration decision.</p>
    <p>LLM Advisor does not provide financial, legal, security, compliance, or procurement advice.</p>
    <p>Advertising, affiliate links, or sponsored relationships may be introduced in the future only with clear disclosure. Current seeded pricing records should be treated as pending verification unless a page states otherwise.</p>
    <p>To report a possible pricing or source issue, email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
  </InfoPage>
</SiteLayout>
