---
import SiteLayout from '@/layouts/SiteLayout.astro';
import InfoPage from '@/components/InfoPage.astro';
import { site } from '@/data/site';
---

<SiteLayout title="Editorial Policy" description="Editorial policy for LLM Advisor cost comparisons and AI product guidance." canonicalPath="/editorial-policy">
  <InfoPage title="Editorial Policy" description="LLM Advisor content should be useful, source-driven, and clear about uncertainty.">
    <p>LLM Advisor aims to publish practical AI cost guidance based on verifiable public information. Pages should avoid exaggerated claims, hidden assumptions, and unsupported rankings.</p>
    <p>Meaningful updates should include a visible update date. Material pricing claims should include source attribution. Google AdSense or other advertising may appear on the site, but advertising does not determine editorial recommendations, rankings, or methodology-driven conclusions.</p>
    <p>Sponsored placements, affiliate links, or partner relationships must be disclosed before such content appears.</p>
    <p>AI assistance may be used to draft, structure, or update content, but future agents and maintainers must verify factual claims against official or clearly attributed sources.</p>
    <p>Editorial corrections can be sent to <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
  </InfoPage>
</SiteLayout>
