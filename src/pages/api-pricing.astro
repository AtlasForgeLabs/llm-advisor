---
import SiteLayout from '@/layouts/SiteLayout.astro';
import InfoPage from '@/components/InfoPage.astro';
---

<SiteLayout title="API Pricing" description="Static foundation page for future AI model and API pricing comparisons." canonicalPath="/api-pricing">
  <InfoPage title="API Pricing" description="This section will organize model pricing, token costs, and usage assumptions for API cost decisions.">
    <p>The API Pricing area is prepared for future static data covering model input costs, output costs, context limits, and relevant billing units.</p>
    <p>Future data must be static JSON or generated before build, with source URLs and review dates included for auditability.</p>
  </InfoPage>
</SiteLayout>
