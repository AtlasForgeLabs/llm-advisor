---
import SiteLayout from '@/layouts/SiteLayout.astro';
import InfoPage from '@/components/InfoPage.astro';
import { site } from '@/data/site';
---

<SiteLayout title="Privacy Policy" description="Privacy policy for the static LLM Advisor website." canonicalPath="/privacy">
  <InfoPage title="Privacy Policy" description="LLM Advisor is designed as a static website and does not require user accounts or server-side data storage.">
    <h2>Static website model</h2>
    <p>LLM Advisor does not provide login, payment, or account features. The website is intended to run as a static GitHub Pages-compatible site.</p>
    <h2>Analytics and third parties</h2>
    <p>If analytics, advertising, affiliate links, or embedded third-party services are added later, this policy must be updated before deployment. Any such additions should be reviewed for privacy impact and disclosed clearly.</p>
    <h2>Contact and corrections</h2>
    <p>If you email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>, the information you send will be used to review and respond to your request. Do not send private account credentials, API keys, or confidential vendor contracts.</p>
  </InfoPage>
</SiteLayout>
