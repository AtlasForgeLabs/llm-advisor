---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { lastUpdated } from '@/data/site';
import { getPricingImportManifest } from '@/lib/data';

const pricingImport = getPricingImportManifest();

const pillars = [
  {
    title: 'Compare',
    text: 'Review AI subscriptions and usage models side by side with consistent cost categories.'
  },
  {
    title: 'Calculate',
    text: 'Estimate API, subscription, and team spend with client-side calculators that use your manual inputs.'
  },
  {
    title: 'Choose',
    text: 'Match product options to practical workloads, not generic rankings or one-size-fits-all advice.'
  },
  {
    title: 'Optimize',
    text: 'Track plan changes, budget impact, and savings opportunities with transparent source attribution.'
  }
];

const placeholders = [
  {
    title: 'Compare AI Plans',
    href: '/plans',
    text: 'Browse plan records with verification status, source links, and clear pending labels.'
  },
  {
    title: 'Calculate API Cost',
    href: '/calculators/ai-api-cost',
    text: 'Use manual token and price inputs while verified pricing normalization is pending.'
  },
  {
    title: 'Explore Price Radar',
    href: '/price-radar',
    text: 'Review price change records only when source and timestamp context are present.'
  },
  {
    title: 'View Methodology',
    href: '/methodology',
    text: 'Read how LLM Advisor separates verified source data from pending records.'
  }
];

const trustRows = [
  ['Official source attribution', 'Every production pricing claim must connect back to source metadata.'],
  ['Last updated timestamps', 'Records carry checked, updated, and source access dates where available.'],
  ['Transparent methodology', 'Comparisons explain assumptions instead of presenting universal winners.'],
  ['No fake prices', 'Null or unverified numeric prices render as pending verification, never as facts.']
];
---

<SiteLayout
  title="AI Cost Advisor for Models, Plans, and API Pricing"
  description="Compare AI subscriptions, model pricing, and API costs in one place."
  canonicalPath="/"
>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <h1>AI Cost Advisor for Models, Plans, and API Pricing</h1>
        <p class="hero-copy">Compare AI subscriptions, model pricing, and API costs in one place.</p>
        <div class="hero-actions">
          <a class="button" href="/plans">Compare AI Plans</a>
          <a class="button secondary" href="/calculators/ai-api-cost">Calculate API Cost</a>
        </div>
      </div>
      <div class="insight-panel" aria-label="Cost decision preview">
        <div class="panel-topline">
          <span>Static data contract</span>
          <strong>No backend</strong>
        </div>
        <div class="panel-row">
          <div>
            <p class="panel-label">Decision lens</p>
            <p class="panel-value">Plans, APIs, and team usage</p>
          </div>
          <strong>Static</strong>
        </div>
        <div class="panel-row">
          <div>
            <p class="panel-label">Savings signal</p>
            <p class="panel-value saving">Optimize cost per workload</p>
          </div>
          <strong>Green</strong>
        </div>
        <div class="panel-row">
          <div>
            <p class="panel-label">Price movement</p>
            <p class="panel-value change">Track notable plan changes</p>
          </div>
          <strong>Orange</strong>
        </div>
        <div class="panel-row">
          <div>
            <p class="panel-label">Last updated</p>
            <p class="panel-value">{lastUpdated}</p>
          </div>
          <strong>Public</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Built for practical AI spending decisions</h2>
        <p>
          LLM Advisor is a static AI cost and decision platform for individuals, developers,
          creators, startups, and small teams comparing AI products and pricing models.
        </p>
      </div>
      <div class="grid">
        {pillars.map((pillar) => (
          <article class="card">
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <h2>Start with the right cost question</h2>
        <p>
          Source-backed pricing is available for selected plans and API models. Some providers
          remain pending due to regional, rendering, or access limitations.
        </p>
        <p class="import-status-note">
          Last OpenClaw import: {pricingImport.imported_at.slice(0, 10)} · Status:{' '}
          {pricingImport.import_status.replaceAll('_', ' ')} · {pricingImport.subscription_imported_count}{' '}
          subscription and {pricingImport.api_imported_count} API records imported (QA-approved).
        </p>
      </div>
      <div class="grid">
        {placeholders.map((item) => (
          <a class="card placeholder-card feature-link" href={item.href}>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <div class="tag-row">
              <span class="tag">Static</span>
              <span class="tag">Source-aware</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Trust signals from day one</h2>
        <p>
          Cost recommendations are useful only when readers can inspect the assumptions behind
          them. LLM Advisor is structured around source visibility and clear update practices.
        </p>
      </div>
      <table class="data-table trust-table">
        <thead>
          <tr><th>Trust indicator</th><th>How it appears on LLM Advisor</th><th>Status</th></tr>
        </thead>
        <tbody>
          {trustRows.map(([label, text]) => (
            <tr>
              <td><strong>{label}</strong></td>
              <td>{text}</td>
              <td><span class="data-badge green">Built in</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</SiteLayout>
