---
import SiteLayout from '@/layouts/SiteLayout.astro';
import InfoPage from '@/components/InfoPage.astro';
import { site } from '@/data/site';
---

<SiteLayout title="About" description="Learn what LLM Advisor is building and how it helps readers compare AI costs." canonicalPath="/about">
  <InfoPage title="About LLM Advisor" description="LLM Advisor helps readers compare AI plans, model pricing, API usage costs, and team spending with transparent assumptions.">
    <h2>What this project is</h2>
    <p>LLM Advisor is an AI cost and decision platform for individuals, developers, creators, startups, and small teams. The site is designed to help readers understand the real cost of AI products across subscriptions, model APIs, and team usage patterns.</p>
    <h2>Current stage</h2>
    <p>The project is currently a production-oriented static website with a static data contract, generated directory pages, and client-side calculators. Seeded pricing records are labeled pending verification until official sources are reviewed and normalized.</p>
    <h2>Contact</h2>
    <p>For corrections, source updates, and editorial questions, email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
  </InfoPage>
</SiteLayout>
