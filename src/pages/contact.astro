---
import SiteLayout from '@/layouts/SiteLayout.astro';
import InfoPage from '@/components/InfoPage.astro';
import { site } from '@/data/site';
---

<SiteLayout title="Contact" description="Contact LLM Advisor for corrections, source updates, and editorial questions." canonicalPath="/contact">
  <InfoPage title="Contact" description="Use this page for correction requests, source updates, and editorial questions about LLM Advisor.">
    <p>Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> for correction requests, official source updates, methodology questions, or editorial feedback.</p>
    <p>When requesting a correction, include the page URL, the affected claim, the official source URL, and the date you checked the source. This helps keep pricing and plan information auditable.</p>
    <p>LLM Advisor does not currently provide account support, paid subscriptions, procurement services, or vendor sales support.</p>
  </InfoPage>
</SiteLayout>
