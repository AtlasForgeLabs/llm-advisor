---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}
---

<BaseLayout title={Astro.props.title} description={Astro.props.description} canonicalPath={Astro.props.canonicalPath}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
